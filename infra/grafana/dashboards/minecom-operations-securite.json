                        "rawQuery": true,
                        "rawSql": "SELECT\r\n  time,\r\n  type_message AS metric,\r\n  nb_messages  AS value\r\nFROM v_messages_par_type_heure\r\nWHERE $__timeFilter(time)\r\n  AND categorie = 'METIER'\r\nORDER BY time",
