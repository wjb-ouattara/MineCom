# Copier ce fichier en .env (racine) et dans infra/.env, puis renseigner les valeurs.
# Les fichiers .env ne sont jamais commités.

# PostgreSQL
DB_USERNAME=
DB_PASSWORD=

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Grafana
# Compte admin Grafana (lu via env_file par docker-compose.grafana.yml)
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
# Utilisateur PostgreSQL lecture seule (grafana_reader) utilisé par Grafana
GRAFANA_DB_PASSWORD=
