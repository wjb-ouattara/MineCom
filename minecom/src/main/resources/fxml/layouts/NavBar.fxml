<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      spacing="8"
      alignment="TOP_CENTER"
      styleClass="navbar"
      fx:controller="com.mining.minecom.controller.NavBarController">

    <padding>
        <Insets top="10" bottom="10"/>
    </padding>

    <!-- 🔑 BADGE SOS ROUGE -->
    <StackPane fx:id="sosBadgeContainer"
               prefWidth="44" prefHeight="44"
               visible="false" managed="false"
               onMouseClicked="#handleSOSBadgeClick"
               style="-fx-cursor: hand;">
        <Circle fx:id="sosCircle" radius="18" fill="#DC2626"
                style="-fx-effect: dropshadow(gaussian, rgba(220,38,38,0.8), 10, 0, 0, 0);"/>
        <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="18" iconColor="white"/>
    </StackPane>

    <VBox prefHeight="5"/>

    <!-- Bouton SOS d'envoi -->
    <Button fx:id="sosBtn" onAction="#handleSOS" styleClass="sos-button">
        <graphic>
            <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="24" iconColor="white"/>
        </graphic>
        <tooltip><Tooltip text="ENVOYER ALERTE SOS"/></tooltip>
    </Button>

    <VBox prefHeight="10"/>

    <!-- 🔑 MESSAGES BUTTON + BADGE GLOBAL -->
    <StackPane prefWidth="44" prefHeight="44" alignment="CENTER">
        <Button fx:id="messagesBtn" onAction="#showMessages" styleClass="nav-button">
            <graphic>
                <FontIcon iconLiteral="fas-comments" iconSize="20" styleClass="nav-icon"/>
            </graphic>
            <tooltip><Tooltip text="Messages"/></tooltip>
        </Button>

        <!-- 🔑 BADGE GLOBAL : visible en FXML, contrôlé par code -->
        <StackPane fx:id="globalBadgePane"
                   visible="false"
                   managed="false"
                   mouseTransparent="true"
                   maxWidth="-Infinity" maxHeight="-Infinity"
                   StackPane.alignment="TOP_RIGHT"
                   translateX="8"
                   translateY="-8">
            <Circle fx:id="globalBadgeCircle" radius="10"
                    fill="#e74c3c" stroke="white" strokeWidth="2"/>
            <Label fx:id="globalBadgeText" text="0"
                   style="-fx-text-fill: white; -fx-font-size: 9px; -fx-font-weight: bold;"/>
        </StackPane>
    </StackPane>

    <Separator/>

    <Button fx:id="contactsBtn" onAction="#showContacts" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-users" iconSize="20" styleClass="nav-icon"/></graphic>
        <tooltip><Tooltip text="Contacts"/></tooltip>
    </Button>

    <Separator/>

    <Button fx:id="callsBtn" onAction="#showCalls" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-phone" iconSize="20" styleClass="nav-icon"/></graphic>
        <tooltip><Tooltip text="Appels"/></tooltip>
    </Button>

    <Button fx:id="notificationsBtn" onAction="#showNotifications" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-bell" iconSize="20" styleClass="nav-icon"/></graphic>
        <tooltip><Tooltip text="Notifications"/></tooltip>
    </Button>

    <Button fx:id="tasksBtn" onAction="#showTasks" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-tasks" iconSize="20" styleClass="nav-icon"/></graphic>
        <tooltip><Tooltip text="Tâches"/></tooltip>
    </Button>

    <Separator VBox.vgrow="ALWAYS" style="-fx-opacity: 0;"/>

    <Button fx:id="settingsBtn" onAction="#showSettings" styleClass="nav-button">
        <graphic><FontIcon iconLiteral="fas-cog" iconSize="20" styleClass="nav-icon"/></graphic>
        <tooltip><Tooltip text="Paramètres"/></tooltip>
    </Button>

    <Button fx:id="profileBtn" onAction="#showProfile" styleClass="nav-button-profile">
        <graphic>
            <StackPane fx:id="profileAvatar"
                       prefWidth="36" prefHeight="36"
                       minWidth="36" minHeight="36"
                       maxWidth="36" maxHeight="36"
                       styleClass="profile-avatar"/>
        </graphic>
        <tooltip><Tooltip text="Mon profil"/></tooltip>
    </Button>

</VBox>