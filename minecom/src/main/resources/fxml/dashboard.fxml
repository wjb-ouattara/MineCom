<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mining.minecom.controller.DashboardController"
            styleClass="dashboard"
            prefHeight="800"
            prefWidth="1400">

    <top>
        <HBox fx:id="titleBar"
              styleClass="title-bar"
              alignment="CENTER_LEFT">
            <ImageView fx:id="icon" fitWidth="20" fitHeight="20" styleClass="mineIcon" />
            <Label text="MineCom" styleClass="title-text"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button onAction="#minimizeWindow" styleClass="title-button-mini">
                <graphic>
                    <FontIcon iconLiteral="fas-minus" iconSize="12" iconColor="white"/>
                </graphic>
            </Button>
            <StackPane fx:id="maximizeContainer">
                <Button fx:id="maximizeBtn" onAction="#maximizeWindow" styleClass="title-button-max">
                    <graphic>
                        <FontIcon iconLiteral="fas-square" iconSize="12" iconColor="white"/>
                    </graphic>
                </Button>
            </StackPane>
            <Button onAction="#closeWindow" styleClass="title-button-close">
                <graphic>
                    <FontIcon iconLiteral="fas-times" iconSize="14" iconColor="white"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <!-- 🔑 AJOUT : prefHeight pour forcer la hauteur -->
        <HBox prefHeight="750">
            <fx:include fx:id="sidebar" source="layouts/sidebar.fxml"/>

            <StackPane fx:id="mainArea"
                       styleClass="main-area"
                       HBox.hgrow="ALWAYS">

                <ImageView fx:id="bgImage"
                           opacity="0.7"
                           smooth="true"
                           cache="true"/>

                <VBox>
                    <fx:include fx:id="topbar" source="layouts/topbar.fxml"/>

                    <ScrollPane fx:id="chatScrollPane"
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                styleClass="chat-scroll"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="chatContainer" spacing="10">
                            <padding>
                                <Insets top="15" right="40" bottom="15" left="40"/>
                            </padding>
                        </VBox>
                    </ScrollPane>

                    <!-- 🔑 Ajoutez ce bloc JUSTE AVANT le HBox de la zone de saisie (message-box) -->
                    <HBox fx:id="replyPreviewBar"
                          visible="false"
                          managed="false"
                          alignment="CENTER_LEFT"
                          spacing="10"
                          style="-fx-background-color: #f0f0f0; -fx-padding: 8 15 8 15; -fx-border-color: #FF8C00; -fx-border-width: 0 0 0 4;">

                        <!-- Icône mining unique -->
                        <FontIcon iconLiteral="fas-hard-hat" iconSize="16" iconColor="#FF8C00"/>

                        <VBox HBox.hgrow="ALWAYS" spacing="2">
                            <Label fx:id="replyToLabel"
                                   text="Répondre à"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #FF8C00;"/>
                            <Label fx:id="replyPreviewText"
                                   text=""
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"
                                   maxWidth="400"/>
                        </VBox>

                        <Button onAction="#cancelReply"
                                style="-fx-background-color: transparent; -fx-cursor: hand;">
                            <graphic>
                                <FontIcon iconLiteral="fas-times" iconSize="14" iconColor="#888"/>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- La zone de saisie existante suit ici (message-box) -->

                    <HBox spacing="10" styleClass="message-box" alignment="CENTER">
                        <padding>
                            <Insets right="20" bottom="20" left="20"/>
                        </padding>

                        <ComboBox fx:id="messageTypeSelector"
                                  promptText="Type"
                                  styleClass="type-selector"
                                  prefWidth="140"/>

                        <TextArea fx:id="messageInput"
                                  wrapText="true"
                                  prefRowCount="1"
                                  maxHeight="150"
                                  promptText="Taper votre message..."
                                  HBox.hgrow="ALWAYS"
                                  styleClass="messageField"/>

                        <!-- Ajoutez ces 2 boutons AVANT le bouton d'envoi (paper-plane) -->
                        <Button fx:id="imageBtn" onAction="#handleSendImage"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 8;">
                            <graphic>
                                <FontIcon iconLiteral="fas-image" iconSize="20" iconColor="#FF8C00"/>
                            </graphic>
                            <tooltip><Tooltip text="Envoyer une image"/></tooltip>
                        </Button>

                        <Button fx:id="pdfBtn" onAction="#handleSendPdf"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 8;">
                            <graphic>
                                <FontIcon iconLiteral="fas-file-pdf" iconSize="20" iconColor="#DC2626"/>
                            </graphic>
                            <tooltip><Tooltip text="Envoyer un PDF"/></tooltip>
                        </Button>

                        <Button onAction="#handleSendMessage" styleClass="sendButton">
                            <graphic>
                                <FontIcon iconLiteral="fas-paper-plane" iconSize="18"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
            </StackPane>

            <padding>
                <Insets top="8" right="35" bottom="20" left="10"/>
            </padding>
        </HBox>
    </center>
</BorderPane>