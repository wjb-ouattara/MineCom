<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.mining.minecom.controller.SOSAlertPopupController"
           styleClass="sos-overlay"
           fx:id="overlay">

    <!-- Fond semi-transparent -->
    <VBox alignment="CENTER" spacing="30" styleClass="sos-alert-container">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <!-- Icône d'alerte -->
        <FontIcon iconLiteral="fas-exclamation-triangle"
                  iconSize="80"
                  iconColor="white"/>

        <!-- Titre -->
        <Label text="ALERTE SOS"
               styleClass="sos-title"/>

        <!-- Informations -->
        <VBox alignment="CENTER" spacing="15" styleClass="sos-info-box">
            <HBox spacing="10" alignment="CENTER">
                <Label text="De :" styleClass="sos-label"/>
                <Label fx:id="senderLabel"
                       text="Utilisateur"
                       styleClass="sos-value"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Localisation :" styleClass="sos-label"/>
                <Label fx:id="locationLabel"
                       text="Non spécifié"
                       styleClass="sos-value"/>
            </HBox>

            <VBox spacing="5" alignment="CENTER">
                <Label text="Description :" styleClass="sos-label"/>
                <Label fx:id="descriptionLabel"
                       text=""
                       wrapText="true"
                       maxWidth="400"
                       styleClass="sos-value"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER">
                <Label text="Heure :" styleClass="sos-label"/>
                <Label fx:id="timeLabel"
                       text="--:--"
                       styleClass="sos-value"/>
            </HBox>
        </VBox>

        <!-- Compteur d'accusés -->
        <HBox alignment="CENTER" spacing="10" styleClass="sos-counter">
            <FontIcon iconLiteral="fas-check-circle"
                      iconSize="24"
                      iconColor="white"/>
            <Label fx:id="ackCountLabel"
                   text="0 / 0 accusés de réception"
                   styleClass="sos-counter-text"/>
        </HBox>

        <!-- Boutons -->
        <HBox spacing="20" alignment="CENTER">
            <Button text="J'AI REÇU L'ALERTE"
                    onAction="#handleAcknowledge"
                    styleClass="sos-ack-button"/>

            <Button text="Fermer"
                    onAction="#handleClose"
                    styleClass="sos-close-button"/>
        </HBox>
    </VBox>
</StackPane>